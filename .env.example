# Required. Crossref, Unpaywall and arXiv expect contact info; Crossref's
# polite pool depends on it. The server refuses to start without it.
CONTACT_EMAIL=you@example.org

# Strongly recommended. Free, 30 seconds: openalex.org/settings/api
# Without it the daily budget is $0.10 instead of $1.00.
OPENALEX_API_KEY=

# Optional. Raises Semantic Scholar rate limits.
S2_API_KEY=

# Strongly recommended. Without it the Railway URL is a public endpoint that
# anyone can use to spend your API budget.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# The public hostname this server is reached on, WITHOUT scheme or path
# (e.g. scholarly-mcp.up.railway.app, or your own domain).
#
# The MCP transport validates the Host header against this. If it is wrong,
# /mcp answers 421 to every request while /health still returns 200 — a green
# deploy in front of a dead server. Railway sets RAILWAY_PUBLIC_DOMAIN
# automatically, so on Railway you usually do not need this. Set it when you put
# a custom domain or a CDN in front, and use the domain the CLIENT connects to.
#
# Leaving it empty disables Host validation entirely (the server still works;
# /health says so in "warnings").
PUBLIC_HOSTNAME=

# Optional tuning
# CACHE_PATH=/tmp/scholarly_cache.sqlite
# CACHE_TTL_SECONDS=604800
# HTTP_TIMEOUT=25
# Ceiling on one outbound fetch including retry backoff, seconds. Keeps a
# rate-limited source from outlasting the client's tool timeout.
# FETCH_DEADLINE=45
